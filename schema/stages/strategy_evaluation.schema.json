{
  "$ref": "#/definitions/ScenarioLab_strategy_evaluation_output",
  "definitions": {
    "ScenarioLab_strategy_evaluation_output": {
      "type": "object",
      "properties": {
        "evaluationCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evaluations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "strategyId": {
                "type": "string",
                "format": "uuid",
                "errorMessage": {
                  "format": "must be an opaque UUID"
                }
              },
              "scenarioId": {
                "$ref": "#/definitions/ScenarioLab_strategy_evaluation_output/properties/evaluations/items/properties/strategyId"
              },
              "rating": {
                "type": "string",
                "enum": [
                  "weak",
                  "adequate",
                  "strong",
                  "not_applicable"
                ]
              },
              "rationale": {
                "$ref": "#/definitions/ScenarioLab_strategy_evaluation_output/properties/evaluationCriteria/items"
              },
              "criterionResults": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "criterion": {
                      "$ref": "#/definitions/ScenarioLab_strategy_evaluation_output/properties/evaluationCriteria/items"
                    },
                    "outcome": {
                      "$ref": "#/definitions/ScenarioLab_strategy_evaluation_output/properties/evaluationCriteria/items"
                    }
                  },
                  "required": [
                    "criterion",
                    "outcome"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "violatedConstraintIds": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/ScenarioLab_strategy_evaluation_output/properties/evaluations/items/properties/strategyId"
                }
              }
            },
            "required": [
              "strategyId",
              "scenarioId",
              "rating",
              "rationale",
              "criterionResults",
              "violatedConstraintIds"
            ],
            "additionalProperties": false
          }
        },
        "robustChoice": {
          "$ref": "#/definitions/ScenarioLab_strategy_evaluation_output/properties/evaluationCriteria/items"
        },
        "conditionalChoices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScenarioLab_strategy_evaluation_output/properties/evaluationCriteria/items"
          }
        },
        "failureConditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScenarioLab_strategy_evaluation_output/properties/evaluationCriteria/items"
          }
        }
      },
      "required": [
        "evaluationCriteria",
        "evaluations",
        "robustChoice",
        "conditionalChoices",
        "failureConditions"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scenariolab.local/schema/stages/strategy_evaluation-2.0.0.json",
  "$comment": "Structured output contract for the strategy_evaluation planning stage."
}
