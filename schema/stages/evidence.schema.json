{
  "$ref": "#/definitions/ScenarioLab_evidence_output",
  "definitions": {
    "ScenarioLab_evidence_output": {
      "type": "object",
      "properties": {
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "$ref": "#/definitions/ScenarioLab_evidence_output/properties/assumptions/items/properties/statement"
              },
              "plausibleAlternatives": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/ScenarioLab_evidence_output/properties/assumptions/items/properties/statement"
                }
              },
              "effectIfWrong": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/ScenarioLab_evidence_output/properties/assumptions/items/properties/statement"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "test": {
                "$ref": "#/definitions/ScenarioLab_evidence_output/properties/assumptions/items/properties/effectIfWrong"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "errorMessage": {
                    "format": "must be an opaque UUID"
                  }
                }
              }
            },
            "required": [
              "statement",
              "basis",
              "plausibleAlternatives",
              "effectIfWrong",
              "test",
              "evidenceIds"
            ],
            "additionalProperties": false
          }
        },
        "evidenceGaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScenarioLab_evidence_output/properties/assumptions/items/properties/statement"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "leftEvidenceId": {
                "$ref": "#/definitions/ScenarioLab_evidence_output/properties/assumptions/items/properties/evidenceIds/items"
              },
              "rightEvidenceId": {
                "$ref": "#/definitions/ScenarioLab_evidence_output/properties/assumptions/items/properties/evidenceIds/items"
              },
              "description": {
                "$ref": "#/definitions/ScenarioLab_evidence_output/properties/assumptions/items/properties/statement"
              },
              "resolution": {
                "$ref": "#/definitions/ScenarioLab_evidence_output/properties/assumptions/items/properties/effectIfWrong"
              }
            },
            "required": [
              "leftEvidenceId",
              "rightEvidenceId",
              "description",
              "resolution"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "assumptions",
        "evidenceGaps",
        "contradictions"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scenariolab.local/schema/stages/evidence-2.0.0.json",
  "$comment": "Structured output contract for the evidence planning stage."
}
